# Required for all examples
OPENAI_API_KEY=sk-your-api-key-here

# Optional: override the default model (default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Required for the subscription migration example (Langfuse tracing)
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_HOST=https://cloud.langfuse.com

# Required for the failed payment example (Temporal)
# Default: localhost:7233 (Temporal local dev server)
TEMPORAL_ADDRESS=localhost:7233
