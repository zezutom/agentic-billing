    {
      "rule": "unlimited_vs_fair_use",
      "kind": "ambiguity",
      "severity": "medium",
      "confidence": "high",
      "headline": "\u201cUnlimited\u201d is advertised, but a fair-use restriction is buried on another page",
      "explanation": "Your commercial pages advertise unlimited API requests, while a separate page qualifies usage with a fair-use or acceptable-use restriction. A customer deciding on price never sees the qualifier; a customer who hits it experiences it as a broken promise.",
