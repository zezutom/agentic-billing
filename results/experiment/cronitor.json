  "findings": [
    {
      "type": "ambiguity",
      "severity": "medium",
      "confidence": "high",
      "headline": "Pricing page sells unlimited API requests. Docs document rate limits.",
      "explanation": "The docs never publish the numbers, so a developer cannot size an integration before building it.",
      "claim_a": {
        "statement": "Unlimited API requests",
        "quote": "Unlimited API requests",
        "url": "https://cronitor.io/pricing"
      },
      "claim_b": {
        "statement": "Rate limited, 429 on excess",
        "quote": "The API has rate limits to ensure fair usage. If you exceed these limits, you'll receive a 429 Too Many Requests response.",
        "url": "https://cronitor.io/docs/api"
      },
      "why_not_just_wording": "Unlimited and refused with a 429 past an unpublished ceiling are different answers to how much you can send.",
      "caveat": "A rate limit caps speed, not volume, so both can be true. One line on the pricing page would close it.",
      "same_page": false,
      "score": 6.0
    },
    {
      "type": "missing_information",
      "severity": "medium",
      "confidence": "medium",
      "headline": "SSO guide names the plan requirement. It omits the $5 per user charge.",
      "explanation": "An admin who follows the guide upgrades to Business and meets the surcharge on the next invoice. On twenty seats that is $100 a month.",
      "claim_a": {
        "statement": "SSO costs $5 per user extra",
        "quote": "SAML SSO (+$5/mo per user)",
        "url": "https://cronitor.io/pricing"
      },
      "claim_b": {
        "statement": "Just subscribe to Business",
        "quote": "Note: If the button is disabled, ensure your team is subscribed to the Business plan.",
        "url": "https://cronitor.io/docs/saml-sso"
      },
      "why_not_just_wording": "One page states a per-user charge the other omits while answering what a customer needs to use the feature.",
      "caveat": "The guide is not wrong, a Business subscription genuinely is required. Six more words would make it complete.",
      "same_page": false,
      "score": 3.4
    }
  ],
