  "findings": [
    {
      "type": "ambiguity",
      "severity": "high",
      "confidence": "high",
      "headline": "Three pages give three answers to what happens when you exceed your plan.",
      "explanation": "A third page says overage is billed only if extra charging is enabled, and never says what happens when it is not.",
      "claim_a": {
        "statement": "$0.009 per extra screenshot",
        "quote": "$0.009 per extra",
        "url": "https://screenshotone.com/pricing"
      },
      "claim_b": {
        "statement": "Throttling or suspension",
        "quote": "throttling, or temporary suspension of access",
        "url": "https://screenshotone.com/terms-of-service"
      },
      "why_not_just_wording": "Paying more, being slowed, and losing access are three different outcomes for the same event.",
      "caveat": "Overage billing is likely the normal path and throttling a reserve power for abuse. The sentence that needs finishing is if extra charging is enabled.",
      "same_page": false,
      "score": 9.0
    },
    {
      "type": "missing_information",
      "severity": "medium",
      "confidence": "high",
      "headline": "Terms allow you to change quotas, not just prices.",
      "explanation": "The allowances are the product, so this says what a customer bought can be redefined mid-subscription.",
      "claim_a": {
        "statement": "Scale includes 50,000 screenshots",
        "quote": "50,000 screenshots",
        "url": "https://screenshotone.com/pricing"
      },
      "claim_b": {
        "statement": "Quotas may change at any time",
        "quote": "We reserve the right to modify pricing, features, usage limits, quotas, or plan structures at any time.",
        "url": "https://screenshotone.com/terms-of-service"
      },
      "why_not_just_wording": "A right to change quotas can reduce what a customer receives without changing what they pay.",
      "caveat": "A notice commitment on the pricing page would neutralise this entirely.",
      "same_page": false,
      "score": 5.1
    },
    {
      "type": "likely_contradiction",
      "severity": "medium",
      "confidence": "medium",
      "headline": "Pricing page promises a full refund. Docs say unused credits are not refunded.",
      "explanation": "A customer who buys Scale, uses a fraction of the 50,000 screenshots and asks for their money back inside a month has been told both.",
      "claim_a": {
        "statement": "Full refund within 30 days",
        "quote": "email us at support@screenshotone.com within 30 days, and we will refund you in full, no questions asked",
        "url": "https://screenshotone.com/pricing"
      },
      "claim_b": {
        "statement": "No refunds for unused credits",
        "quote": "No refunds for unused credits",
        "url": "https://screenshotone.com/docs/credits"
      },
      "why_not_just_wording": "One page promises money back for any reason inside 30 days and the other rules it out for the most common case.",
      "caveat": "These probably address different things, the subscription fee and the cash value of credits. The credits page is where a cancelling customer lands.",
      "same_page": false,
      "score": 4.6
    }
  ],
  "coverage_notes": {
    "unusable_pages": [],
    "what_was_not_checkable": "This is the most complete set of pages of the ten companies: fifteen pages all readable, a pricing page that publishes per-plan quotas, rate limits and overage rates inline, and a credits page that explains reset and rollover behaviour properly. What we could not check is what actually happens when extra charging is disabled and the quota runs out. No page we read says. We also could not confirm whether the free tier survives cancellation. The credits page says a cancelled customer is downgraded to the free plan, or loses access if the free plan is not available, without saying when that would be the case."
  },
